{
  "name": "Miklens Trial Manager",
  "short_name": "TrialManager",
  "description": "Professional agricultural research platform for tracking, evaluating, and reporting on bio-efficacy trials",
  "version": "3.0.0",
  "id": "com.miklens.trialmanager",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "background_color": "#ecfdf5",
  "theme_color": "#059669",
  "categories": [
    "productivity",
    "business",
    "utilities",
    "science"
  ],
  "lang": "en",
  "dir": "ltr",
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "auto"
  },
  "capture_links": "existing-client-navigate",
  "handle_links": "preferred",
  "icons": [
    {
      "src": "./favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-72x72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-96x96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-128x128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-144x144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-152x152.png",
      "sizes": "152x152",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icons/icon-384x384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Field Dashboard",
      "short_name": "Dashboard",
      "description": "View trial metrics, active tests & KPIs",
      "url": "./index.html#/",
      "icons": [{ "src": "./icons/icon-96x96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "New Field Trial",
      "short_name": "New Trial",
      "description": "Start a new bio-efficacy field evaluation",
      "url": "./index.html#/trials?action=new",
      "icons": [{ "src": "./icons/icon-96x96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Plot Scanner",
      "short_name": "Scanner",
      "description": "Scan plot QR markers to log observations",
      "url": "./index.html#/scanner",
      "icons": [{ "src": "./icons/icon-96x96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Evaluation Reports",
      "short_name": "Reports",
      "description": "Generate scientific dossiers & statistical reports",
      "url": "./index.html#/reports",
      "icons": [{ "src": "./icons/icon-96x96.png", "sizes": "96x96", "type": "image/png" }]
    }
  ],
  "related_applications": []
}