// Firestore Security Rules for Category Isolation Enforcement
// Aligned with src/services/firebase.js:
// - Herbicide uses base collection names (trials, projects, formulations, blocks)
// - Other categories use ${category}_${collectionType} (e.g. fungicide_trials)

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ═══ HELPER FUNCTIONS ═══════════════════════════════════════════════════════
    
    // Valid categories in the application
    function isValidCategory(category) {
      return category in ['herbicide', 'fungicide', 'pesticide', 'nutrition', 'biostimulant'];
    }
    
    // Check if document has a valid category field
    function hasValidCategory(data) {
      let category = 'Category' in data ? data.Category : ('category' in data ? data.category : null);
      return category != null && isValidCategory(category);
    }
    
    // Get category from document data
    function getCategory(data) {
      return 'Category' in data ? data.Category : ('category' in data ? data.category : 'herbicide');
    }
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is admin
    function isAdmin() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc != null && 'Role' in userDoc.data && 
             (userDoc.data.Role == 'Admin' || userDoc.data.Role == 'admin');
    }
    
    // Check if user has access to specific category
    function hasCategoryAccess(category) {
      if (!isAuthenticated()) return false;
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      if (userDoc == null) return true; // Fallback during initial provisioning
      let user = userDoc.data;
      
      // Admin users have access to all categories
      if ('Role' in user && (user.Role == 'Admin' || user.Role == 'admin')) {
        return true;
      }
      
      // Check category access list
      if ('categoryAccess' in user && user.categoryAccess[category] != null) {
        return user.categoryAccess[category].read != false;
      }
      
      if ('CategoryAccess' in user && user.CategoryAccess[category] != null) {
        return true;
      }
      
      // Default: allow access
      return true;
    }
    
    // Check if user owns the document
    function isOwner(docData) {
      return isAuthenticated() && 
             ('CreatedBy' in docData ? docData.CreatedBy == request.auth.uid : true);
    }
    
    // Check if user has edit permission
    function canEdit(docData) {
      return isOwner(docData) || 
             isAdmin() ||
             ('SharedWithEdit' in docData && request.auth.uid in docData.SharedWithEdit);
    }
    
    // Check if trial category matches project category
    function trialProjectCategoryMatch(trialData) {
      let pid = 'ProjectId' in trialData ? trialData.ProjectId : ('ProjectID' in trialData ? trialData.ProjectID : null);
      if (pid == null || pid == '') {
        return true;
      }
      let trialCategory = getCategory(trialData);
      let coll = trialCategory == 'herbicide' ? 'projects' : (trialCategory + '_projects');
      let projectPath = /databases/$(database)/documents/$(coll)/$(pid);
      return exists(projectPath);
    }
    
    // Check if formulation ingredients are category-compatible
    function formulationIngredientCategoryMatch(formulationData) {
      return true; // Backward compatibility
    }
    
    // Comprehensive category isolation check
    function enforcesCategoryIsolation(data, targetCategory) {
      let docCategory = getCategory(data);
      return docCategory == targetCategory && 
             hasCategoryAccess(docCategory) &&
             trialProjectCategoryMatch(data) &&
             formulationIngredientCategoryMatch(data);
    }
    
    // ═══ USER MANAGEMENT & SETTINGS ═════════════════════════════════════════════
    
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // ═══ SHARED COLLECTIONS ═════════════════════════════════════════════════════
    
    match /organisations/{orgId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    match /ingredients/{ingredientId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    match /analysisLog/{logId} {
      allow read, write: if isAuthenticated();
    }

    match /syncConflicts/{conflictId} {
      allow read, write: if isAuthenticated();
    }

    match /sprayLogs/{logId} {
      allow read, write: if isAuthenticated();
    }

    match /aiChatSessions/{sessionId} {
      allow read, write: if isAuthenticated();
    }

    match /embeddingsAll/{embeddingId} {
      allow read, write: if isAuthenticated();
    }
    
    // ═══ HERBICIDE COLLECTIONS (Standard names) ═════════════════════════════════
    
    match /trials/{trialId} {
      allow read: if isAuthenticated() && hasCategoryAccess('herbicide');
      allow create: if isAuthenticated() && hasCategoryAccess('herbicide') && enforcesCategoryIsolation(request.resource.data, 'herbicide');
      allow update: if isAuthenticated() && hasCategoryAccess('herbicide') && enforcesCategoryIsolation(request.resource.data, 'herbicide') && canEdit(resource.data);
      allow delete: if isAuthenticated() && hasCategoryAccess('herbicide') && canEdit(resource.data);
    }
    
    match /projects/{projectId} {
      allow read: if isAuthenticated() && hasCategoryAccess('herbicide');
      allow create: if isAuthenticated() && hasCategoryAccess('herbicide');
      allow update: if isAuthenticated() && hasCategoryAccess('herbicide') && canEdit(resource.data);
      allow delete: if isAuthenticated() && hasCategoryAccess('herbicide') && canEdit(resource.data);
    }
    
    match /formulations/{formulationId} {
      allow read: if isAuthenticated() && hasCategoryAccess('herbicide');
      allow create: if isAuthenticated() && hasCategoryAccess('herbicide');
      allow update: if isAuthenticated() && hasCategoryAccess('herbicide') && canEdit(resource.data);
      allow delete: if isAuthenticated() && hasCategoryAccess('herbicide') && canEdit(resource.data);
    }
    
    match /blocks/{blockId} {
      allow read, write: if isAuthenticated() && hasCategoryAccess('herbicide');
    }

    // ═══ FUNGICIDE COLLECTIONS ══════════════════════════════════════════════════
    
    match /fungicide_trials/{trialId} {
      allow read: if isAuthenticated() && hasCategoryAccess('fungicide');
      allow create: if isAuthenticated() && hasCategoryAccess('fungicide') && enforcesCategoryIsolation(request.resource.data, 'fungicide');
      allow update: if isAuthenticated() && hasCategoryAccess('fungicide') && enforcesCategoryIsolation(request.resource.data, 'fungicide') && canEdit(resource.data);
      allow delete: if isAuthenticated() && hasCategoryAccess('fungicide') && canEdit(resource.data);
    }
    
    match /fungicide_projects/{projectId} {
      allow read: if isAuthenticated() && hasCategoryAccess('fungicide');
      allow create, update, delete: if isAuthenticated() && hasCategoryAccess('fungicide') && canEdit(resource.data);
    }
    
    match /fungicide_formulations/{formulationId} {
      allow read: if isAuthenticated() && hasCategoryAccess('fungicide');
      allow create, update, delete: if isAuthenticated() && hasCategoryAccess('fungicide') && canEdit(resource.data);
    }
    
    match /fungicide_ingredients/{id} {
      allow read, write: if isAuthenticated() && hasCategoryAccess('fungicide');
    }
    
    match /fungicide_blocks/{id} {
      allow read, write: if isAuthenticated() && hasCategoryAccess('fungicide');
    }

    // ═══ PESTICIDE COLLECTIONS ══════════════════════════════════════════════════
    
    match /pesticide_trials/{trialId} {
      allow read: if isAuthenticated() && hasCategoryAccess('pesticide');
      allow create: if isAuthenticated() && hasCategoryAccess('pesticide') && enforcesCategoryIsolation(request.resource.data, 'pesticide');
      allow update: if isAuthenticated() && hasCategoryAccess('pesticide') && enforcesCategoryIsolation(request.resource.data, 'pesticide') && canEdit(resource.data);
      allow delete: if isAuthenticated() && hasCategoryAccess('pesticide') && canEdit(resource.data);
    }
    
    match /pesticide_projects/{projectId} {
      allow read: if isAuthenticated() && hasCategoryAccess('pesticide');
      allow create, update, delete: if isAuthenticated() && hasCategoryAccess('pesticide') && canEdit(resource.data);
    }
    
    match /pesticide_formulations/{formulationId} {
      allow read: if isAuthenticated() && hasCategoryAccess('pesticide');
      allow create, update, delete: if isAuthenticated() && hasCategoryAccess('pesticide') && canEdit(resource.data);
    }
    
    match /pesticide_ingredients/{id} {
      allow read, write: if isAuthenticated() && hasCategoryAccess('pesticide');
    }
    
    match /pesticide_blocks/{id} {
      allow read, write: if isAuthenticated() && hasCategoryAccess('pesticide');
    }

    // ═══ NUTRITION COLLECTIONS ══════════════════════════════════════════════════
    
    match /nutrition_trials/{trialId} {
      allow read: if isAuthenticated() && hasCategoryAccess('nutrition');
      allow create: if isAuthenticated() && hasCategoryAccess('nutrition') && enforcesCategoryIsolation(request.resource.data, 'nutrition');
      allow update: if isAuthenticated() && hasCategoryAccess('nutrition') && enforcesCategoryIsolation(request.resource.data, 'nutrition') && canEdit(resource.data);
      allow delete: if isAuthenticated() && hasCategoryAccess('nutrition') && canEdit(resource.data);
    }
    
    match /nutrition_projects/{projectId} {
      allow read: if isAuthenticated() && hasCategoryAccess('nutrition');
      allow create, update, delete: if isAuthenticated() && hasCategoryAccess('nutrition') && canEdit(resource.data);
    }
    
    match /nutrition_formulations/{formulationId} {
      allow read: if isAuthenticated() && hasCategoryAccess('nutrition');
      allow create, update, delete: if isAuthenticated() && hasCategoryAccess('nutrition') && canEdit(resource.data);
    }
    
    match /nutrition_ingredients/{id} {
      allow read, write: if isAuthenticated() && hasCategoryAccess('nutrition');
    }
    
    match /nutrition_blocks/{id} {
      allow read, write: if isAuthenticated() && hasCategoryAccess('nutrition');
    }

    // ═══ BIOSTIMULANT COLLECTIONS ═══════════════════════════════════════════════
    
    match /biostimulant_trials/{trialId} {
      allow read: if isAuthenticated() && hasCategoryAccess('biostimulant');
      allow create: if isAuthenticated() && hasCategoryAccess('biostimulant') && enforcesCategoryIsolation(request.resource.data, 'biostimulant');
      allow update: if isAuthenticated() && hasCategoryAccess('biostimulant') && enforcesCategoryIsolation(request.resource.data, 'biostimulant') && canEdit(resource.data);
      allow delete: if isAuthenticated() && hasCategoryAccess('biostimulant') && canEdit(resource.data);
    }
    
    match /biostimulant_projects/{projectId} {
      allow read: if isAuthenticated() && hasCategoryAccess('biostimulant');
      allow create, update, delete: if isAuthenticated() && hasCategoryAccess('biostimulant') && canEdit(resource.data);
    }
    
    match /biostimulant_formulations/{formulationId} {
      allow read: if isAuthenticated() && hasCategoryAccess('biostimulant');
      allow create, update, delete: if isAuthenticated() && hasCategoryAccess('biostimulant') && canEdit(resource.data);
    }
    
    match /biostimulant_ingredients/{id} {
      allow read, write: if isAuthenticated() && hasCategoryAccess('biostimulant');
    }
    
    match /biostimulant_blocks/{id} {
      allow read, write: if isAuthenticated() && hasCategoryAccess('biostimulant');
    }
  }
}